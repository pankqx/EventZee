<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Events"
            android:textSize="30sp" android:textStyle="bold"
            android:textColor="@color/text_primary"/>
        <ImageView
            android:id="@+id/tv_user_name"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_profile_avatar"
            android:background="@drawable/circle_bg"/>
    </LinearLayout>

    <!-- Search bar -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="16dp">
        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="44dp"
            android:paddingEnd="14dp"
            android:hint="Search by name, date, or venue..."
            android:textSize="13sp"
            android:textColorHint="@color/text_hint"
            android:inputType="text"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_search"
            android:tint="@color/text_secondary"/>
    </FrameLayout>

    <!-- Category chips -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:layout_marginTop="14dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/chip_all" android:layout_width="wrap_content"
                android:layout_height="36dp" android:text="All Events"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:gravity="center" android:textSize="13sp"
                android:background="@drawable/chip_selected"
                android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/chip_academic" android:layout_width="wrap_content"
                android:layout_height="36dp" android:text="Academic"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:gravity="center" android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:textColor="@color/text_primary" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/chip_social" android:layout_width="wrap_content"
                android:layout_height="36dp" android:text="Social"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:gravity="center" android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:textColor="@color/text_primary" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/chip_sports" android:layout_width="wrap_content"
                android:layout_height="36dp" android:text="Sports"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:gravity="center" android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:textColor="@color/text_primary"/>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_events"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"/>

</LinearLayout>
