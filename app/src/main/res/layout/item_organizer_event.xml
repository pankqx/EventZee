<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/tv_dot" android:layout_width="10dp" android:layout_height="10dp"
                android:src="@drawable/circle_dot" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tv_event_title" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
            <TextView android:id="@+id/tv_status" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textStyle="bold" android:paddingStart="10dp" android:paddingEnd="10dp"
                android:paddingTop="4dp" android:paddingBottom="4dp"
                android:background="@drawable/badge_live"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp" android:layout_marginStart="18dp">
            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                android:src="@drawable/ic_calendar" android:tint="@color/text_secondary"/>
            <TextView android:id="@+id/tv_date_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="@color/text_secondary" android:layout_marginStart="4dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_no_regs" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="No registrations yet" android:textSize="12sp"
                android:textColor="@color/text_secondary" android:textStyle="italic"
                android:visibility="gone"/>
            <TextView android:id="@+id/btn_view_registrations"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="View Registrations →"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
            <LinearLayout android:id="@+id/btn_edit_event"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Edit Event" android:textSize="13sp"
                    android:textStyle="bold" android:textColor="@color/text_primary"/>
                <ImageView android:layout_width="14dp" android:layout_height="14dp"
                    android:src="@drawable/ic_edit" android:tint="@color/text_primary"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
