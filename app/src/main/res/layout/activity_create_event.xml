<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <!-- Toolbar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <ImageView android:id="@+id/iv_back" android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_arrow_back" android:tint="@color/text_primary"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Create Event" android:textSize="18sp"
                android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center"/>
        </LinearLayout>

        <!-- Banner upload -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="100dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/bg_dashed_border" android:layout_marginTop="16dp">
            <ImageView android:layout_width="30dp" android:layout_height="30dp"
                android:src="@drawable/ic_camera" android:tint="@color/text_secondary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Upload Event Banner" android:textSize="13sp"
                android:textColor="@color/text_secondary" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Form fields -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Event Title" android:textSize="13sp" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_marginTop="16dp"/>
        <EditText android:id="@+id/et_title" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:hint="e.g., Annual Tech Symposium" android:textSize="14sp"
            android:textColorHint="@color/text_hint"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Institution Name" android:textSize="13sp" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_marginTop="14dp"/>
        <EditText android:id="@+id/et_institution" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:hint="e.g., Stanford University" android:textSize="14sp"
            android:textColorHint="@color/text_hint"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Organizer Name" android:textSize="13sp" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_marginTop="14dp"/>
        <EditText android:id="@+id/et_organizer_name" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:hint="e.g., Tech Club President" android:textSize="14sp"
            android:textColorHint="@color/text_hint"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Date" android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/et_date" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:hint="mm/dd/yyyy" android:textSize="14sp"
                    android:textColorHint="@color/text_hint" android:focusable="false"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Time" android:textSize="13sp" android:textColor="@color/text_primary"
                    android:textStyle="bold"/>
                <EditText android:id="@+id/et_time" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingStart="14dp" android:paddingEnd="14dp"
                    android:hint="--:-- --" android:textSize="14sp"
                    android:textColorHint="@color/text_hint" android:focusable="false"/>
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Event Category" android:textSize="13sp" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_marginTop="14dp"/>
        <Spinner android:id="@+id/spinner_category" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="14dp" android:paddingEnd="14dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Venue" android:textSize="13sp" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_marginTop="14dp"/>
        <EditText android:id="@+id/et_venue" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:hint="e.g., Main Auditorium" android:textSize="14sp"
            android:textColorHint="@color/text_hint"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Description (Optional)" android:textSize="13sp" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_marginTop="14dp"/>
        <EditText android:id="@+id/et_description" android:layout_width="match_parent"
            android:layout_height="100dp" android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp"
            android:hint="Briefly describe the event..." android:textSize="14sp"
            android:textColorHint="@color/text_hint"
            android:gravity="top" android:inputType="textMultiLine"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Payment Details" android:textSize="18sp"
            android:textStyle="bold" android:textColor="@color/text_primary"
            android:layout_marginTop="24dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="UPI ID" android:textSize="13sp" android:textColor="@color/text_primary"
            android:textStyle="bold" android:layout_marginTop="14dp"/>
        <EditText android:id="@+id/et_upi_id" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:hint="e.g., eventname@upi" android:textSize="14sp"
            android:textColorHint="@color/text_hint"/>

        <Button android:id="@+id/btn_create_event"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/btn_primary"
            android:text="Create Event"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
