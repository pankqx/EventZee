            android:theme="@style/Theme.EventZee.NoActionBar" />

        <activity
            android:name=".ui.student.PaymentActivity"
            android:exported="false"
            android:theme="@style/Theme.EventZee.NoActionBar" />

        <activity
            android:name=".ui.student.ETicketActivity"
            android:exported="false"
            android:theme="@style/Theme.EventZee.NoActionBar" />

        <activity
            android:name=".ui.organizer.OrganizerActivity"
            android:exported="false"
            android:theme="@style/Theme.EventZee.NoActionBar" />

        <activity
            android:name=".ui.organizer.CreateEventActivity"
            android:exported="false"
            android:theme="@style/Theme.EventZee.NoActionBar" />

        <activity
            android:name=".ui.organizer.RegistrationsListActivity"
            android:exported="false"
            android:theme="@style/Theme.EventZee.NoActionBar" />

    </application>
</manifest>
