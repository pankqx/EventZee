            android:exported="false"
            android:theme="@style/Theme.EventZee.NoActionBar" />

        <activity
            android:name=".ui.student.EventDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.EventZee.NoActionBar" />

        <activity
            android:name=".ui.student.RegistrationFormActivity"
